{
  "name": "perplexity-mcp",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "browser": {
    "binding": "BROWSER"
  },
  "ratelimits": [
    {
      "name": "MCP_RATE_LIMITER",
      "namespace_id": "820260802",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}
