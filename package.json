{
  "name": "perplexity-custom-mcp",
  "version": "1.5.1",
  "description": "Cloudflare Workers MCP server: Perplexity search plus a no-JS page fetcher",
  "type": "module",
  "main": "src/worker.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "check": "npm run test && npm run typecheck",
    "smoke": "node scripts/live-smoke.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "^0.32.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261101.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.0"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
