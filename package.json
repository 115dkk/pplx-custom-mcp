{
  "name": "perplexity-custom-mcp",
  "version": "1.2.0",
  "description": "Cloudflare Workers MCP server: Perplexity search plus a no-JS page fetcher",
  "type": "module",
  "main": "src/worker.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "check": "npm run test && npm run typecheck",
    "smoke": "node scripts/live-smoke.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "agents": "^0.20.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@types/node": "^26.1.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.118.0"
  }
}
